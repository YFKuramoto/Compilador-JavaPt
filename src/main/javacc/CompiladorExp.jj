options {
    STATIC = false;
}

PARSER_BEGIN(CompiladorExp)
package com.example;

import java.util.*;

public class CompiladorExp {

    // Interfaces para executar comandos e expressões após validar a sintaxe
    public interface Comando { void executar(); }
    public interface Expr { double avaliar(); }

    private final Map<String, Double> variaveis = new HashMap<String, Double>();
    private Scanner entrada = new Scanner(System.in).useLocale(Locale.US);

    public void setEntrada(Scanner scanner) {
        this.entrada = scanner;
    }

    // --- Métodos auxiliares (compatíveis com o parser interno do JavaCC) ---

    private Comando se(final Expr cond, final Comando entao, final Comando senao) {
        return new Comando() {
            public void executar() {
                if (cond.avaliar() != 0.0) entao.executar();
                else if (senao != null) senao.executar();
            }
        };
    }

    private Comando enquanto(final Expr cond, final Comando corpo) {
        return new Comando() {
            public void executar() {
                while (cond.avaliar() != 0.0) corpo.executar();
            }
        };
    }

    private Comando atrib(final String nome, final Expr val) {
        return new Comando() {
            public void executar() {
                variaveis.put(nome, val.avaliar());
            }
        };
    }

    private Comando leia(final String nome) {
        return new Comando() {
            public void executar() {
                System.out.print("Digite o valor de " + nome + ": ");
                variaveis.put(nome, entrada.nextDouble());
            }
        };
    }

    private Comando escreva(final Expr val) {
        return new Comando() {
            public void executar() {
                System.out.println("=> O resultado da expressao e: " + val.avaliar());
            }
        };
    }

    private Expr num(String texto) {
        final double valor = Double.parseDouble(texto);
        return new Expr() {
            public double avaliar() { return valor; }
        };
    }

    private Expr var(final String nome) {
        return new Expr() {
            public double avaliar() {
                if (!variaveis.containsKey(nome)) {
                    throw new RuntimeException("Variavel '" + nome + "' nao foi inicializada!");
                }
                return variaveis.get(nome);
            }
        };
    }

    private Expr op(final Expr e1, final String operador, final Expr e2) {
        return new Expr() {
            public double avaliar() {
                double a = e1.avaliar(), b = e2.avaliar();
                switch (operador) {
                    case "+":  return a + b;
                    case "-":  return a - b;
                    case "*":  return a * b;
                    case "/":
                        if (b == 0.0) throw new RuntimeException("Divisao por zero!");
                        return a / b;
                    case "<":  return (a < b)  ? 1.0 : 0.0;
                    case ">":  return (a > b)  ? 1.0 : 0.0;
                    case "=":  return (a == b) ? 1.0 : 0.0;
                    case "<>": return (a != b) ? 1.0 : 0.0;
                    default:   return 0.0;
                }
            }
        };
    }

    public static void main(String[] args) {
        try {
            System.out.println("----------------------------------------");
            System.out.println("Compilador iniciado!");
            System.out.println("Digite o programa e aperte Enter.");
            System.out.println("Para sair, aperte Ctrl+Z (Windows) ou Ctrl+D (Linux/Mac) e Enter.");
            System.out.println("----------------------------------------");

            CompiladorExp parser = new CompiladorExp(System.in);
            parser.programa();

            System.out.println("\n=> Sintaxe Correta!");
        } catch (ParseException e) {
            System.out.println("\n[ERRO] Erro de Sintaxe encontrado!");
            System.out.println(e.getMessage());
        } catch (TokenMgrError e) {
            System.out.println("\n[ERRO] Erro Lexico (simbolo invalido) encontrado!");
            System.out.println(e.getMessage());
        } catch (RuntimeException e) {
            System.out.println("\n[ERRO] Erro Semantico encontrado!");
            System.out.println(e.getMessage());
        }
    }
}

PARSER_END(CompiladorExp)

/* 1. ANALISADOR LÉXICO: IGNORAR ESPAÇOS E DEFINIR TOKENS */

SKIP : { " " | "\t" | "\r" | "\n" }

SKIP : {
      <"//" (~["\n", "\r"])*>
    | <"/*" (~["*"])* "*" ( ~["*", "/"] (~["*"])* "*" | "*" )* "/">
}

TOKEN : {
      <SE: "se">
    | <ENTAO: "entao">
    | <SENAO: "senao">
    | <FIM: "fim">
    | <ENQUANTO: "enquanto">
    | <FACA: "faca">
    | <LEIA: "leia">
    | <ESCREVA: "escreva">
}

TOKEN : {
      <ATRIB: ":=">
    | <PONTO_VIRGULA: ";">
    | <APARENTESES: "(">
    | <FPARENTESES: ")">
    | <DIFERENTE: "<>">
    | <MENOR: "<">
    | <MAIOR: ">">
    | <IGUAL: "=">
    | <MAIS: "+">
    | <MENOS: "-">
    | <MULT: "*">
    | <DIV: "/">
}

TOKEN : {
      <#LETRA: ["a"-"z", "A"-"Z"]>
    | <#DIGITO: ["0"-"9"]>
    | <NUMERO: (<DIGITO>)+ ( "." (<DIGITO>)+ )?>
    | <IDENTIFICADOR: <LETRA> (<LETRA> | <DIGITO>)*>
}

/* 2. ANALISADOR SINTÁTICO E SEMÂNTICO (REGRAS DA GRAMÁTICA) */

// programa -> sequenciaDecl EOF
void programa() :
{ Comando resultado; }
{
    resultado = sequenciaDecl() <EOF>
    { resultado.executar(); }
}

// sequenciaDecl -> ( declaracao ";" )+
Comando sequenciaDecl() :
{ final List<Comando> lista = new ArrayList<Comando>(); Comando cmd; }
{
    ( cmd = declaracao() <PONTO_VIRGULA> { lista.add(cmd); } )+
    {
        return new Comando() {
            public void executar() {
                for (Comando c : lista) c.executar();
            }
        };
    }
}

// declaracao -> condDecl | repetDecl | atribDecl | leitDecl | escrDecl
Comando declaracao() :
{ Comando cmd; }
{
    ( cmd = condDecl() | cmd = repetDecl() | cmd = atribDecl() | cmd = leitDecl() | cmd = escrDecl() )
    { return cmd; }
}

// condDecl -> "se" expressao "entao" sequenciaDecl ( "senao" sequenciaDecl )? "fim"
Comando condDecl() :
{ Expr cond; Comando bEntao, bSenao = null; }
{
    <SE> cond = expressao() <ENTAO> bEntao = sequenciaDecl()
    [ <SENAO> bSenao = sequenciaDecl() ]
    <FIM>
    { return se(cond, bEntao, bSenao); }
}

// repetDecl -> "enquanto" expressao "faca" sequenciaDecl "fim"
Comando repetDecl() :
{ Expr cond; Comando corpo; }
{
    <ENQUANTO> cond = expressao() <FACA> corpo = sequenciaDecl() <FIM>
    { return enquanto(cond, corpo); }
}

// atribDecl -> identificador ":=" expressao
Comando atribDecl() :
{ Token t; Expr val; }
{
    t = <IDENTIFICADOR> <ATRIB> val = expressao()
    { return atrib(t.image, val); }
}

// leitDecl -> "leia" identificador
Comando leitDecl() :
{ Token t; }
{
    <LEIA> t = <IDENTIFICADOR>
    { return leia(t.image); }
}

// escrDecl -> "escreva" expressao
Comando escrDecl() :
{ Expr val; }
{
    <ESCREVA> val = expressao()
    { return escreva(val); }
}

// expressao -> exp ( ("<"|">"|"="|"<>") exp )?
Expr expressao() :
{ Expr val1, val2; }
{
    val1 = Exp()
    [
        <MENOR> val2 = Exp()     { val1 = op(val1, "<", val2); }
      | <MAIOR> val2 = Exp()     { val1 = op(val1, ">", val2); }
      | <IGUAL> val2 = Exp()     { val1 = op(val1, "=", val2); }
      | <DIFERENTE> val2 = Exp() { val1 = op(val1, "<>", val2); }
    ]
    { return val1; }
}

// exp -> termo ( ("+"|"-") termo )*
Expr Exp() :
{ Expr val1, val2; }
{
    val1 = Termo()
    (
        <MAIS> val2 = Termo()  { val1 = op(val1, "+", val2); }
      | <MENOS> val2 = Termo() { val1 = op(val1, "-", val2); }
    )*
    { return val1; }
}

// termo -> fator ( ("*"|"/") fator )*
Expr Termo() :
{ Expr val1, val2; }
{
    val1 = Fator()
    (
        <MULT> val2 = Fator() { val1 = op(val1, "*", val2); }
      | <DIV> val2 = Fator()  { val1 = op(val1, "/", val2); }
    )*
    { return val1; }
}

// fator -> "(" expressao ")" | numero | identificador
Expr Fator() :
{ Expr val; Token t; }
{
    <APARENTESES> val = expressao() <FPARENTESES> { return val; }
  | t = <NUMERO>        { return num(t.image); }
  | t = <IDENTIFICADOR> { return var(t.image); }
}