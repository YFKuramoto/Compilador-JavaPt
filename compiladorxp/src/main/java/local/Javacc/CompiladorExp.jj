options {
STATIC = false;
}
PARSER_BEGIN(CompiladorExp)
public class CompiladorExp {
public static void main(String[] args) {
try {
System.out.println("----------------------------------------
");
System.out.println(" Compilador iniciado!");
System.out.println(" Digite uma expressao (ex: 2+3*4) e
aperte Enter.");
System.out.println(" Para sair, aperte Ctrl+Z (Windows) ou
Ctrl+D (Linux/Mac) e Enter.");
System.out.println("----------------------------------------
");
// Instancia o parser lendo do teclado (System.in)
CompiladorExp parser = new CompiladorExp(System.in);
// Inicia a análise e guarda o resultado final calculado
double resultado = parser.Start();
System.out.println("\n=> Sintaxe Correta!");
System.out.println("=> O resultado da expressao e: " +
resultado);
} catch (ParseException e) {
System.out.println("\n[ERRO] Erro de Sintaxe encontrado!");
System.out.println(e.getMessage());
} catch (TokenMgrError e) {
System.out.println("\n[ERRO] Erro Lexico (simbolo invalido)
encontrado!");
System.out.println(e.getMessage());
}
}
}
PARSER_END(CompiladorExp)
/* 1. ANALISADOR LÉXICO: IGNORAR ESPAÇOS E DEFINIR TOKENS */
SKIP : { " " | "\t" | "\r" | "\n" }
TOKEN : {
< MAIS: "+" >
| < MENOS: "-" >
| < MULT: "*" >
| < APARENTESES: "(" >
| < FPARENTESES: ")" >
| < NUMERO: (["0"-"9"])+ >
}

/* 2. ANALISADOR SINTÁTICO E SEMÂNTICO (REGRAS DA GRAMÁTICA) */
// Regra inicial
double Start() :
{ double resultado; } // Variável Java para guardar o resultado
{
resultado = Exp() <EOF>
{ return resultado; }
}
// exp -> termo ( ("+"|"-") termo )*
double Exp() :
{ double val1, val2; }
{
val1 = Termo()
(
<MAIS> val2 = Termo() { val1 = val1 + val2; } // Ação semântica
da soma
|
<MENOS> val2 = Termo() { val1 = val1 - val2; } // Ação semântica
da subtração
)*
{ return val1; }
}
// termo -> fator ( "*" fator )*
double Termo() :
{ double val1, val2; }
{
val1 = Fator()
(
<MULT> val2 = Fator() { val1 = val1 * val2; } // Ação semântica
da multiplicação
)*
{ return val1; }
}
// fator -> "(" exp ")" | numero
double Fator() :
{ double val; Token t; }
{
// Se iniciar com parênteses, resolve a expressão dentro deles
<APARENTESES> val = Exp() <FPARENTESES>
{ return val; }
|
// Se for um número, captura o texto do token e converte para double
t = <NUMERO>
{ return Double.parseDouble(t.image); }
}